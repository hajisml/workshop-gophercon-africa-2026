package components

import "workshop/internal/domain/sighting"

templ SpecimenCard(s sighting.Sighting) {
	<article class="specimen">
		<div class="specimen__scan">
			if m, ok := firstPhoto(s); ok {
				<img src={ m.URL } alt={ photoAlt(s, m) } loading="lazy" decoding="async"/>
			} else {
				<p class="specimen__no-image">No visual feed</p>
			}
			<span class="specimen__tag">{ specimenCode(s) }</span>
			if g := Group(s); g != "" {
				<span class="specimen__group">{ g }</span>
			}
		</div>
		<div class="specimen__body">
			<h3 class="specimen__name">
				<a href={ SpecimenURL(s) }>{ displayName(s.Species) }</a>
			</h3>
			if s.Species.ScientificName != "" {
				<p class="specimen__latin">{ s.Species.ScientificName }</p>
			}
			<p class="specimen__place">{ place(s.Location) }</p>
			<footer class="credit">
				<p class="credit__who">
					<span class="credit__label">Observer</span>
					if s.RecordedBy != "" {
						{ s.RecordedBy }
					} else {
						Unknown observer
					}
				</p>
				<p class="credit__when mono">
					<time datetime={ s.HappenedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ loggedAt(s.HappenedAt) }</time>
				</p>
			</footer>
			<p class="specimen__open mono" aria-hidden="true">Open file →</p>
		</div>
	</article>
}
