package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Terra Scan · Scan deck",
		Description: "A holographic atlas of wildlife sightings from around the world, with field notes and observer credits.",
		Page:        "scan",
	}) {
		if len(sightings) == 0 {
			@noSignals()
		} else {
			@hero(sightings, sum)
			@modules(sightings, sum)
			<section id="specimens" class="section archive">
				<div class="section__head reveal">
					<p class="eyebrow">Specimen archive</p>
					<h2 data-decode>Browse every signal</h2>
					<p class="section__lede">Narrow the archive by class, animal or region. Open any specimen for its full file.</p>
				</div>
				<div class="archive__layout">
					@components.Filter(components.FilterProps{
						Target: "specimen-list",
						Search: true,
						Groups: []components.FilterGroup{
							{Key: "group", Label: "Class", Options: components.FilterOptions(sightings, 0, components.Group)},
							{Key: "animal", Label: "Animal", Options: components.FilterOptions(sightings, 14, components.Animal)},
							{Key: "country", Label: "Region", Options: components.FilterOptions(sightings, 12, components.Country)},
						},
					})
					<div class="archive__results">
						<ul id="specimen-list" class="specimens" data-page-size="24">
							for _, s := range sightings {
								<li { components.FilterAttrs(s)... }>
									@components.SpecimenCard(s)
								</li>
							}
						</ul>
						<p class="no-match" hidden>No specimens match these filters.</p>
						<p class="load-more" hidden>
							<button type="button" class="lab-button">Load more specimens</button>
						</p>
					</div>
				</div>
			</section>
			<script src="/assets/js/filter.js" defer></script>
		}
	}
}

templ hero(sightings []sighting.Sighting, sum sighting.Summary) {
	<section id="globe" class="hero">
		<div class="hero__intro reveal">
			<p class="eyebrow"><span class="pulse" aria-hidden="true"></span>Live biosphere scan</p>
			<h1 data-decode>Every signal is an animal someone saw.</h1>
			<p class="hero__lede">Spin the globe to scan the planet. Each point of light is a sighting; select one to open its specimen file.</p>
			<dl class="stats">
				<div class="panel stat">
					<dt>Signals</dt>
					<dd data-count>{ sum.Sightings }</dd>
				</div>
				<div class="panel stat">
					<dt>Species</dt>
					<dd data-count>{ sum.Species }</dd>
				</div>
				<div class="panel stat">
					<dt>Regions</dt>
					<dd data-count>{ sum.Countries }</dd>
				</div>
				<div class="panel stat">
					<dt>Observers</dt>
					<dd data-count>{ sum.Recorders }</dd>
				</div>
			</dl>
			<p class="hero__range mono">Archive span { sum.Earliest.Format("2006") } → { sum.Latest.Format("2006") }</p>
		</div>
		<div class="globe panel reveal" style="--reveal-delay: 150ms">
			<span class="globe__corner globe__corner--tl" aria-hidden="true"></span>
			<span class="globe__corner globe__corner--br" aria-hidden="true"></span>
			<span class="globe__sweep" aria-hidden="true"></span>
			@templ.JSONScript("globe-points", components.GlobePoints(sightings))
			@components.ThreeScene(components.ThreeSceneProps{
				Scene: "globe",
				Label: "A rotating globe with a glowing point for each sighting. The same sightings are listed in the archive below.",
			})
			<p class="globe__readout mono" aria-live="polite"></p>
			<p class="globe__hint">Drag to rotate · select a signal</p>
		</div>
	</section>
}

templ modules(sightings []sighting.Sighting, sum sighting.Summary) {
	<nav class="modules" aria-label="Lab modules">
		<a class="module panel reveal" href="/tracker">
			<span class="module__code mono">02</span>
			<span class="module__name">Wildlife tracker</span>
			<span class="module__desc">Lock on to one animal and replay its trail across the globe.</span>
			<span class="module__go mono" aria-hidden="true">Engage →</span>
		</a>
		<a class="module panel reveal" href="/analysis" style="--reveal-delay: 120ms">
			<span class="module__code mono">03</span>
			<span class="module__name">Analysis lab</span>
			<span class="module__desc">Activity by year and season, top animals and regions, across { sum.Species } species.</span>
			<span class="module__go mono" aria-hidden="true">Analyse →</span>
		</a>
		<a class="module panel reveal" href="/observers" style="--reveal-delay: 240ms">
			<span class="module__code mono">04</span>
			<span class="module__name">Observers</span>
			<span class="module__desc">Credits for the { sum.Recorders } people in the field behind every record.</span>
			<span class="module__go mono" aria-hidden="true">View credits →</span>
		</a>
	</nav>
}
